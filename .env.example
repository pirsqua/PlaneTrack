# OpenSky Network — OAuth2 client credentials
OPENSKY_CLIENT_ID=your_client_id
OPENSKY_CLIENT_SECRET=your_client_secret
# Optional overrides (defaults shown)
# OPENSKY_BASE_URL=https://opensky-network.org/api
# OPENSKY_TOKEN_URL=https://opensky-network.org/api/auth/realms/opensky-network/protocol/openid-connect/token

# Azure Data Lake Gen2
AZURE_ACCOUNT_NAME=your_storage_account_name
AZURE_ACCOUNT_KEY=your_storage_account_key
ADLS_CONTAINER=planetrack

# Pipeline
# How often to poll OpenSky (seconds, minimum 10)
PIPELINE_INTERVAL_SECONDS=60

# App
ENVIRONMENT=local
LOG_LEVEL=INFO
